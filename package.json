{
  "name": "devbuddy",
  "private": true,
  "version": "0.1.0",
  "description": "研发好朋友 DevBuddy — 离线可用的开发者工具箱浏览器扩展",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vue-tsc --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview --port 5199",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "smoke:views": "node scripts/smoke-views.mjs",
    "smoke:all": "node scripts/smoke.mjs && node scripts/smoke-views.mjs",
    "shot:views": "node scripts/shot-views.mjs",
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
