{
  "name": "site-keys",
  "private": true,
  "version": "0.4.3",
  "description": "便签本 Sticky — 便签网格 + 整页记事本双模块，支持导入 txt，打开就填、输入即存的纯本地 MV3 扩展",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vue-tsc --noEmit && vite build",
    "build:only": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
