{
  "manifest_version": 3,
  "name": "网迹",
  "version": "1.5.3",
  "description": "把浏览历史按域名、书签按文件夹、已打开的标签页按域名聚合成卡片，支持全量搜索、域内限定搜索、清除历史、书签管理与标签页清理。本地运行，不上传任何数据。",
  "permissions": ["history", "favicon", "bookmarks", "tabs"],
  "action": {
    "default_title": "打开网迹",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": { "service_worker": "sw.js" },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+H" },
      "description": "打开网迹"
    }
  },
  "omnibox": { "keyword": "h" }
}
